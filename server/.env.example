## Server
NODE_ENV=development
PORT=5000
API_VERSION=v1
BASE_URL=http://localhost:5000

## Supabase
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=replace-with-your-anon-key
# Required by the Express API after the core-table RLS lockdown. Never expose it
# through NEXT_PUBLIC_* variables or commit the real value.
SUPABASE_SERVICE_ROLE_KEY=replace-with-your-service-role-key
# Private bucket for National ID and selfie uploads. Create it in Supabase Storage
# with public access disabled.
SUPABASE_VERIFICATION_BUCKET=farmer-verifications
SUPABASE_ASSETS_BUCKET=agriculnet-assets

## Bcrypt
# Retained only for one-time import of legacy password hashes into Supabase Auth.
BCRYPT_SALT_ROUNDS=12

## Email
EMAIL_PROVIDER=resend
EMAIL_FROM=AgriculNet <inf@agriculnet.farm>
# Add your Resend API key after verifying agriculnet.farm and the inf@ sender identity.
RESEND_API_KEY=

## Optional local SMTP fallback for ad-hoc development only
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

## SMS
# Sandbox mode: AT_SANDBOX=true and AT_USERNAME=sandbox with your sandbox API key.
# Live mode: AT_SANDBOX=false and AT_USERNAME=your live Africa's Talking app username.
# Leave AT_SENDER_ID blank for school/dev projects to use Africa's Talking's default sender.
# Only set AT_SENDER_ID after it has been approved on your Africa's Talking account.
SMS_PRIMARY_PROVIDER=africastalking
AT_API_KEY=replace-with-your-africas-talking-api-key
AT_USERNAME=replace-with-your-africas-talking-username
AT_SENDER_ID=
AT_SANDBOX=true
SMS_TEST_TO=+2376XXXXXXXX

# Non-production fixed OTPs. The phone must match public.users.phone after
# normalization. Never configure fixed OTPs in production.
SMS_TEST_OTP={"+237600000000":"123456"}
# Optional development-wide OTP for every phone number. This is ignored in
# production even if accidentally configured.
SMS_DEV_FIXED_OTP=123456

## Twilio (optional - for international SMS)
TWILIO_ACCOUNT_SID=replace-with-your-twilio-account-sid
TWILIO_AUTH_TOKEN=replace-with-your-twilio-auth-token
# Prefer a Messaging Service SID (usually starts with MG). If it is blank,
# TWILIO_PHONE_NUMBER is used as the sender instead.
TWILIO_MESSAGING_SERVICE_SID=replace-with-your-twilio-messaging-service-sid
TWILIO_PHONE_NUMBER=replace-with-your-twilio-phone-number

## Meta WhatsApp Cloud API (privacy-protected supplier message relay)
## Keep disabled until migration 040 is applied and the Meta webhook is configured.
## Full setup: ../WHATSAPP_RELAY_API_SETUP.md
## Meta Cloud API: https://www.postman.com/meta/whatsapp-business-platform/documentation/wlk6lh4/whatsapp-cloud-api
WHATSAPP_RELAY_ENABLED=false
# Meta system-user token with whatsapp_business_messaging and
# whatsapp_business_management. Never expose this through NEXT_PUBLIC_*.
WHATSAPP_ACCESS_TOKEN=
# Numeric Phone Number ID from Meta App Dashboard -> WhatsApp -> API Setup.
WHATSAPP_PHONE_NUMBER_ID=
# Generate this random value yourself; enter the same value in Meta's webhook form.
WHATSAPP_VERIFY_TOKEN=
# Meta App Dashboard -> App settings -> Basic -> App secret.
WHATSAPP_APP_SECRET=
# Confirm that this version remains supported before production activation.
WHATSAPP_API_VERSION=v23.0
# Recommended for supplier notifications outside WhatsApp's 24-hour service
# window. Create and approve this Utility template in WhatsApp Manager.
WHATSAPP_INQUIRY_TEMPLATE_NAME=agriculnet_buyer_inquiry
WHATSAPP_TEMPLATE_LANGUAGE_CODE=en_US
WHATSAPP_REQUEST_TIMEOUT_MS=10000

## Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

## OTP
OTP_LENGTH=6
OTP_EXPIRES_MINUTES=10
OTP_MAX_ATTEMPTS=3

## Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=10

## AgriculNet AI assistant (server-side only)
## Providers are attempted from left to right; providers without a key are skipped.
AI_PROVIDER_ORDER=openrouter,groq,gemini,cerebras
## Create a key at https://openrouter.ai/keys. Never expose it in client environment files.
OPENROUTER_API_KEY=
## `openrouter/free` selects from currently available free models. Override this with
## another OpenRouter model slug when you need a fixed or paid model.
OPENROUTER_MODEL=openrouter/free
## Optional comma-separated OpenRouter model slugs for server-side model failover.
OPENROUTER_FALLBACK_MODELS=

## Independent fallback 1: Groq free plan with an open-weight GPT-OSS model.
## Create a key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

## Independent fallback 2: Google AI Studio free tier (available in Cameroon).
## Create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

## Independent fallback 3: Cerebras Inference free tier and GPT-OSS.
## Create a key at https://cloud.cerebras.ai/
CEREBRAS_API_KEY=
CEREBRAS_MODEL=gpt-oss-120b

## Total provider-chain deadline; keep below the client's 50-second timeout.
AI_REQUEST_TIMEOUT_MS=45000
## Per-provider attempt limit when more than one provider is configured.
AI_PROVIDER_TIMEOUT_MS=10000
AI_RATE_LIMIT_WINDOW_MS=900000
AI_RATE_LIMIT_MAX_REQUESTS=12

## Client URLs
CLIENT_URL=http://localhost:3000
EMAIL_VERIFY_URL=http://localhost:3000/verify-email
PASSWORD_RESET_URL=http://localhost:3000/reset-password

## Fapshi hosted checkout (MTN MoMo / Orange Money)
## Keep sandbox until you are ready to switch to live:
## Sandbox: https://sandbox.fapshi.com
## Live: https://live.fapshi.com
## Add your Fapshi API User and API Key from the Fapshi dashboard below.
FAPSHI_MODE=sandbox
FAPSHI_BASE_URL=https://sandbox.fapshi.com
FAPSHI_API_USER=
FAPSHI_API_KEY=
## Generate a private random HMAC secret. It signs the externalId sent to Fapshi
## and is verified on every callback before the provider status is fetched.
FAPSHI_WEBHOOK_SECRET=
FAPSHI_REQUEST_TIMEOUT_MS=10000

## Development helpers
ALLOW_DEV_DELIVERY_FALLBACK=true
EXPOSE_DEV_AUTH_HINTS=true
