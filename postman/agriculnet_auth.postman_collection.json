{
  "info": {
    "name": "AgriculNet API - Supabase-authenticated endpoints",
    "description": "Obtain access_token through the client Supabase Auth flow at /auth/login. The Express API does not accept passwords or issue sessions.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:5000", "type": "string" },
    { "key": "api_version", "value": "v1", "type": "string" },
    { "key": "access_token", "value": "", "type": "string" },
    { "key": "user_id", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{base_url}}/api/health", "host": ["{{base_url}}"], "path": ["api", "health"] }
      }
    },
    {
      "name": "Get Linked Profile",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
        "url": { "raw": "{{base_url}}/api/{{api_version}}/auth/me", "host": ["{{base_url}}"], "path": ["api", "{{api_version}}", "auth", "me"] }
      }
    },
    {
      "name": "Send Domain Phone OTP",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\"userId\":\"{{user_id}}\",\"purpose\":\"phone_verification\"}" },
        "url": { "raw": "{{base_url}}/api/{{api_version}}/auth/verify-phone/send", "host": ["{{base_url}}"], "path": ["api", "{{api_version}}", "auth", "verify-phone", "send"] }
      }
    }
  ]
}
